{
  "name": "@eduphysics/fluids",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Airfoil Flow Lab: interactive viewer for precomputed Navier-Stokes airfoil flows.",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@eduphysics/ui": "*",
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.48.2",
    "@types/katex": "0.16.7",
    "@types/node": "22.8.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.11.0",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
