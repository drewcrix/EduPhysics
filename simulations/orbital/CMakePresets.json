{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "native",
      "displayName": "Native Release (library, CLI, tests)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "OSIM_BUILD_TESTS": "ON" }
    },
    {
      "name": "native-debug",
      "displayName": "Native Debug with sanitizers",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/native-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "OSIM_BUILD_TESTS": "ON", "OSIM_SANITIZE": "ON" }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "native", "configurePreset": "native" },
    { "name": "native-debug", "configurePreset": "native-debug" },
    { "name": "wasm", "configurePreset": "wasm" }
  ],
  "testPresets": [
    { "name": "native", "configurePreset": "native", "output": { "outputOnFailure": true } },
    { "name": "native-debug", "configurePreset": "native-debug", "output": { "outputOnFailure": true } }
  ]
}
