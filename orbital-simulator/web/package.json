{
  "name": "mission-control-academy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Mission Control Academy — an educational orbit-determination simulator (React + WebAssembly C++ core).",
  "scripts": {
    "wasm:copy": "node scripts/copy-wasm.mjs",
    "predev": "npm run wasm:copy",
    "dev": "vite",
    "prebuild": "npm run wasm:copy",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "validate:content": "vitest run tests/content.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "katex": "0.16.11",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "three": "0.169.0",
    "uplot": "1.6.31",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.48.2",
    "@types/node": "22.8.6",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.13.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "globals": "15.11.0",
    "postcss": "8.4.47",
    "remark-gfm": "4.0.0",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "typescript-eslint": "8.12.2",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
